{
  "$comment": "The one list of user preferences. agent_docs/preference-registry.md explains every entry; src/preferences/catalog.rs is the server's copy of the plain-tier entries, and a test there fails when the two disagree. sync: plain = server-readable and validated; vault = sealed in the browser with the user's key; device = never leaves this browser. paint = applied before first paint from the boot cache. section: where the control lives — a Settings tab id (appearance, calendar, keyboard, advanced, ai), an app or surface (docs, sheets, slides, diagrams, drawing, photos, editors, sidebar), or none while it has no control yet. Settings search is built from it. scopes: who may set the key — user (the person, synced), device (this browser), org (an administrator's default, which they may lock) and team (a default inside that team's space); resolution is org lock, device, user, team, org default, product default.",
  "preferences": [
    {
      "key": "appearance.theme",
      "type": {
        "kind": "string",
        "maxLength": 80,
        "pattern": "^(system|light|dark|glass|midnight|beach|forest|sunbeams|light-glass|custom-[A-Za-z0-9_-]{1,64})$"
      },
      "default": "system",
      "sync": "plain",
      "scopes": [
        "org",
        "user"
      ],
      "paint": true,
      "label": "Theme",
      "section": "appearance",
      "legacyKey": "neutrino.theme"
    },
    {
      "key": "appearance.look",
      "type": {
        "kind": "enum",
        "options": [
          "classic",
          "lightflow",
          "precision",
          "blended"
        ]
      },
      "default": "classic",
      "sync": "plain",
      "scopes": [
        "org",
        "user"
      ],
      "paint": true,
      "label": "Look",
      "section": "appearance"
    },
    {
      "key": "appearance.density",
      "type": {
        "kind": "enum",
        "options": [
          "compact",
          "comfortable",
          "spacious"
        ]
      },
      "default": "comfortable",
      "sync": "plain",
      "scopes": [
        "org",
        "team",
        "user"
      ],
      "paint": true,
      "label": "Density",
      "section": "appearance"
    },
    {
      "key": "appearance.textSize",
